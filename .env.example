# Copiez ce fichier en .env (à côté de docker-compose.yml) et remplissez les valeurs.
# Le fichier .env n'est jamais commité.
ANTHROPIC_API_KEY=
GMAIL_APP_PASSWORD=
GMAIL_USER=tchofodep@gmail.com
ALERT_TO=tchofodep@gmail.com

# Adresse du backend VUE DEPUIS LE CONTENEUR (« localhost » serait le conteneur lui-même) :
#   backend dans la VM (hors Docker)          -> http://host.docker.internal:8080
#   backend sous Windows, VirtualBox en NAT   -> http://10.0.2.2:8080
#   backend sous Windows, autre réseau        -> http://<IP de Windows vue depuis la VM>:8080
SPRING_BOOT_URL=http://10.0.2.2:8080

# Optionnel
LANGSMITH_API_KEY=
